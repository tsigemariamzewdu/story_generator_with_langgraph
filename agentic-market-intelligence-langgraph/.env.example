# ---------------------------------------------------------------------------
# LLM provider — LangChain "<provider>:<model>" convention.
# Uncomment ONE provider block. The pipeline auto-detects which key is set.
# ---------------------------------------------------------------------------

# Default model used when LLM_MODEL is unset:
LLM_MODEL=google_genai:gemini-2.5-flash

# Option A: Google Gemini
GOOGLE_API_KEY=

# Option B: OpenAI
# LLM_MODEL=openai:gpt-4o
# OPENAI_API_KEY=

# Option C: Anthropic
# LLM_MODEL=anthropic:claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Web search — set at least one to get live data. If neither is set, the
# pipeline transparently falls back to deterministic mock search.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Pipeline tuning (optional)
# ---------------------------------------------------------------------------
# Quality threshold below which the evaluator sends the researcher back out.
QUALITY_THRESHOLD=0.8
# Maximum self-correction loops (retries) the researcher is allowed.
MAX_RESEARCH_ITERATIONS=3
# Results per search query.
SEARCH_RESULTS_PER_QUERY=5
